{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests", ":pinAllExceptPeerDependencies"],
  "schedule": ["before 6am on monday"],
  "timezone": "Europe/Paris",
  "packageRules": [
    {
      "description": "One weekly PR for every minor and patch update",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "groupName": "weekly updates"
    }
  ],
  "customManagers": [
    {
      "description": "Keep .bun-version on the latest Bun release",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.bun-version$/"],
      "matchStrings": ["^(?<currentValue>\\d+\\.\\d+\\.\\d+)\\s*$"],
      "depNameTemplate": "oven-sh/bun",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^bun-v(?<version>.*)$"
    }
  ]
}
