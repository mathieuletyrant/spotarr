    "$description": "Warm neutrals, a lighter take on Snug's palette (2026-10-24, #201). Badges are their status color at 12 % over the surface. shadow tints the cards' shadow (none in dark mode), glow is the lamp light at the top of the page (dark mode only)."
  },
  "font": {
    "sans": {
      "$type": "fontFamily",
      "$value": ["Inter", "-apple-system", "BlinkMacSystemFont", "system-ui", "sans-serif"]
    },
    "display": {
      "$type": "fontFamily",
      "$value": ["Fraunces Variable", "Georgia", "serif"],
      "$description": "Page and card titles only."
    },
    "mono": {
      "$type": "fontFamily",
      "$value": ["JetBrains Mono", "SF Mono", "Menlo", "Consolas", "monospace"]
    }
  },
  "spacing": {
    "$type": "dimension",
    "$value": "0.25rem",
    "$description": "Tailwind's spacing step: p-4 is 4 × this."
  },
  "radius": {
    "sm": {
      "$type": "dimension",
      "$value": "8px"
    },
    "md": {
      "$type": "dimension",
      "$value": "12px"
    },
    "lg": {
      "$type": "dimension",
      "$value": "16px"
    },
    "xl": {
      "$type": "dimension",
      "$value": "18px"
    },
    "full": {
      "$type": "dimension",
      "$value": "9999px"
    }
  },
  "icon": {
    "status-progress": {
      "$type": "string",
