{
  "name": "spotarr",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "dev": "pnpm --filter @spotarr/server dev",
    "check": "pnpm lint && pnpm generate && pnpm generated && pnpm breaking && pnpm typecheck && pnpm test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "generate": "pnpm -r generate",
    "generated": "bun scripts/check-generated.ts",
    "breaking": "pnpm --filter @spotarr/contract breaking",
    "typecheck": "tsc && pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.2",
    "typescript": "7.0.2"
  }
}
