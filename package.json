{
  "name": "spotarr",
  "version": "0.15.0",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "dev": "pnpm --recursive --parallel dev",
    "dev:setup": "bun apps/server/scripts/dev-setup.ts",
    "check": "pnpm lint && pnpm knip && pnpm generate && pnpm generated && pnpm breaking && pnpm typecheck && pnpm test",
    "lint": "biome check .",
    "knip": "knip",
    "format": "biome check --write .",
    "generate": "pnpm -r generate",
    "generated": "bun scripts/check-generated.ts",
    "breaking": "pnpm --filter @spotarr/contract breaking",
    "typecheck": "tsc && pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm --filter @spotarr/web build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.2",
    "knip": "6.41.0",
    "typescript": "7.0.2"
  }
}
